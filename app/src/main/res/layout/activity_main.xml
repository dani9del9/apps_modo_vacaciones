<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.dani.modovacaciones.BellView
                android:id="@+id/bellView"
                android:layout_width="68dp"
                android:layout_height="68dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/sub"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Permiso de acceso a notificaciones -->
        <LinearLayout
            android:id="@+id/cardPermission"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_warn"
                android:drawableTint="@color/warn"
                android:text="Falta un permiso"
                android:textColor="@color/warn" />

            <TextView
                style="@style/Body"
                android:text="Para quitar las notificaciones de otras apps, Modo vacaciones necesita «Acceso a notificaciones»." />

            <Button
                android:id="@+id/btnGrantAccess"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Dar acceso a notificaciones" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="14dp"
                android:text="¿Sale en gris o te dice «Ajuste restringido»? Es normal en APKs instalados a mano: abre la info de la app, pulsa ⋮ (arriba a la derecha) → «Permitir ajustes restringidos» y vuelve a intentarlo."
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAppInfo"
                style="@style/Btn.Soft"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Abrir info de la app" />
        </LinearLayout>

        <!-- Botón principal -->
        <Button
            android:id="@+id/btnToggle"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="22dp"
            android:minHeight="68dp"
            android:textSize="19sp" />

        <!-- Apps silenciadas -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_bell_off"
                android:text="Apps silenciadas" />

            <TextView
                android:id="@+id/txtAppsSummary"
                style="@style/Body" />

            <Button
                android:id="@+id/btnChooseApps"
                style="@style/Btn.Soft"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Elegir apps" />
        </LinearLayout>

        <!-- Fecha de fin -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_calendar"
                android:text="Desactivar automáticamente" />

            <TextView
                android:id="@+id/txtEndTime"
                style="@style/Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickDate"
                    style="@style/Btn.Soft"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Elegir fecha y hora" />

                <Button
                    android:id="@+id/btnClearDate"
                    style="@style/Btn.Soft"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Quitar" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtExactHint"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="Sin el permiso de «Alarmas y recordatorios» el aviso puede llegar unos minutos tarde (las notificaciones sí dejan de bloquearse a la hora exacta)."
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnExactPerm"
                style="@style/Btn.Soft"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Permitir alarmas exactas"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Estadísticas -->
        <LinearLayout
            android:id="@+id/cardStats"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtStatsTitle"
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_inbox" />

            <TextView
                android:id="@+id/txtStats"
                style="@style/Body" />

            <Button
                android:id="@+id/btnHistory"
                style="@style/Btn.Soft"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Ver notificaciones" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="💡 Añade el mosaico «Vacaciones» a los ajustes rápidos para activarlo desde la barra de notificaciones."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
